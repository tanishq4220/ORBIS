# ============================================================
# ORBIS — .gitignore
# ============================================================

# --- Secrets & credentials (NEVER commit these) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
# lib/ and lib64/ removed to avoid ignoring backend/lib

sdist/
var/
wheels/
*.whl
*.so
.installed.cfg
*.manifest

# --- Python virtual environments ---
.venv/
venv/
env/
ENV/

# --- Python testing ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
nosetests.xml

# --- Python type checking ---
.mypy_cache/
.dmypy.json
.pytype/

# --- Python linting ---
.ruff_cache/

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
tests/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
test-results/
tests/test-results/

# --- Frontend build outputs ---
frontend/dist/
frontend/.vite/

# --- Large generated data files (tracked separately or regenerated) ---
ACI/aci_output.csv
ml/ml_train.csv
ml/ml_test.csv
ml/ml_model_data.csv
ml/ml_training_features.csv
ml/prediction_error_dataset.csv
ml/training_dataset.csv
ml/labeled_training_dataset.csv

# --- Large binary/archive files ---
*.tar.gz
*.zip
orbis-complete.tar.gz
orbis-complete.zip
orbis-complete-under-500mb.zip
orbis-code.zip

# --- ML model artifacts (large binary files — regenerate from training) ---
# NOTE: random_forest_calibrated.joblib is the PRODUCTION model — explicitly included
# Keeping it committed so the ACI pipeline works without re-training
# ml/random_forest_calibrated.joblib   <- intentionally NOT in gitignore

# --- Screening history (runtime data) ---
backend/screening_history/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Logs ---
*.log
logs/

# --- Temporary files ---
*.tmp
*.temp
tmp/
temp/

# --- Jupyter ---
.ipynb_checkpoints/

# --- emergent platform ---
.emergent/
